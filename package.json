{
  "name": "lexiversex-site",
  "private": true,
  "version": "1.0.0",
  "description": "LexiVerse X 产品介绍站",
  "type": "module",
  "author": "阿亮同学",
  "scripts": {
    "dev": "vite",
    "start": "vite preview --port 4173 --strictPort",
    "build": "vue-tsc --noEmit && vite build",
    "build:only": "vite build",
    "build:docs": "vue-tsc --noEmit && vite build && node scripts/sync-docs.mjs",
    "publish": "node scripts/publish.mjs",
    "preview": "vite preview --port 4173 --strictPort"
  },
  "dependencies": {
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "sass": "^1.83.0",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vue-tsc": "^2.1.10"
  }
}
